+
+/* ---- NewDarkVR M2 spike: per-second statistics on what the engine feeds the D3D9 layer. Remove after the spike. ---- */
+static struct {
+    unsigned frames, draws, rhw, rhw_depth, xf, xf_depth, set_view, set_proj, set_world, view_changes, proj_changes;
+    uint32_t fvf[12]; unsigned fvf_n[12]; unsigned nfvf;
+    float view[16], proj[16], first_view[16], first_proj[16]; int have_last, have_first; unsigned distinct_proj;
+    float proj_seen[4][16];
+} g_m2;
+static void m2_draw(Device *d, const Layout *L) {
+    g_m2.draws++;
+    int depth = d->st.rs[7] != 0;
+    if (L->rhw) { g_m2.rhw++; g_m2.rhw_depth += depth; }
+    else {
+        g_m2.xf++; g_m2.xf_depth += depth;
+        if (g_m2.have_last && memcmp(g_m2.view, d->st.view.m, 64)) g_m2.view_changes++;
+        if (g_m2.have_last && memcmp(g_m2.proj, d->st.proj.m, 64)) g_m2.proj_changes++;
+        memcpy(g_m2.view, d->st.view.m, 64); memcpy(g_m2.proj, d->st.proj.m, 64); g_m2.have_last = 1;
+        if (!g_m2.have_first) { memcpy(g_m2.first_view, d->st.view.m, 64); memcpy(g_m2.first_proj, d->st.proj.m, 64); g_m2.have_first = 1; }
+        unsigned k; for (k = 0; k < g_m2.distinct_proj && k < 4; k++) if (!memcmp(g_m2.proj_seen[k], d->st.proj.m, 64)) break;
+        if (k == g_m2.distinct_proj && k < 4) { memcpy(g_m2.proj_seen[k], d->st.proj.m, 64); g_m2.distinct_proj++; }
+    }
+    unsigned k; for (k = 0; k < g_m2.nfvf; k++) if (g_m2.fvf[k] == d->st.fvf) break;
+    if (k == g_m2.nfvf && k < 12) { g_m2.fvf[k] = d->st.fvf; g_m2.nfvf++; }
+    if (k < 12) g_m2.fvf_n[k]++;
+}
+static void m2_frame(void) {
+    if (++g_m2.frames % 120) return;
+    const float *v = g_m2.first_view, *p = g_m2.first_proj;
+    float cx = -(v[12] * v[0] + v[13] * v[1] + v[14] * v[2]), cy = -(v[12] * v[4] + v[13] * v[5] + v[14] * v[6]), cz = -(v[12] * v[8] + v[13] * v[9] + v[14] * v[10]);
+    float fovy = p[5] != 0 ? 2.0f * atanf(1.0f / p[5]) * 57.29578f : 0, asp = p[5] != 0 ? p[5] / p[0] : 0;
+    port_debug("M2: %u frames  draws/frame %u  pretransformed(XYZRHW) %u (depth-tested %u)  untransformed %u (depth-tested %u)",
+        g_m2.frames, g_m2.draws / 120, g_m2.rhw / 120, g_m2.rhw_depth / 120, g_m2.xf / 120, g_m2.xf_depth / 120);
+    port_debug("M2: SetTransform/frame view %u proj %u world %u; view changes %u proj changes %u distinct proj %u (per 120 frames)",
+        g_m2.set_view / 120, g_m2.set_proj / 120, g_m2.set_world / 120, g_m2.view_changes, g_m2.proj_changes, g_m2.distinct_proj);
+    port_debug("M2: first world view: cam pos %.3f %.3f %.3f  proj fov_y %.1f deg aspect %.3f  proj[10]=%.5f proj[14]=%.5f",
+        cx, cy, cz, fovy, asp, p[10], p[14]);
+    port_debug("M2: view rows: [%.3f %.3f %.3f] [%.3f %.3f %.3f] [%.3f %.3f %.3f] t[%.3f %.3f %.3f]", v[0], v[1], v[2], v[4], v[5], v[6], v[8], v[9], v[10], v[12], v[13], v[14]);
+    for (unsigned k = 0; k < g_m2.nfvf; k++) port_debug("M2: FVF 0x%X: %u draws/frame", g_m2.fvf[k], g_m2.fvf_n[k] / 120);
+    unsigned fr = g_m2.frames; memset(&g_m2, 0, sizeof g_m2); g_m2.frames = fr;
+}
