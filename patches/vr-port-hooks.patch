+void vr_d3d_gun_pass(int mode, float f, float cx, float cy) {
+    /* The engine batches its draws: the weapon it queues after the camera pass's depth clear only reaches the device
+     * at the next flush (EndScene). So when the camera pass did that clear, everything that arrives in mode 3 is it. */
+    vr_vm_phase = mode == 3 ? vr_gun_zseen : 0;
+    if (mode == 1) vr_gun_zseen = 0;
+    vr_gun_mode = mode;
+    if (mode == 3) { vr_gun_len = 0; vr_gun_capf = f; vr_gun_cx = cx; vr_gun_cy = cy;
+                     vr_gun_nv = vr_gun_near = vr_gun_draws = 0; for (int k = 0; k < 3; k++) { vr_gun_bmin[k] = 1e30f; vr_gun_bmax[k] = -1e30f; }
+                     memset(vr_gun_mom, 0, sizeof vr_gun_mom); memset(vr_gun_rgb, 0, sizeof vr_gun_rgb); }
+}
