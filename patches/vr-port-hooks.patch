+static uint8_t *vr_gun_buf; static size_t vr_gun_len, vr_gun_cap;   /* kept draws: [size_t total][blob] ... */
+static void vr_gun_keep(const uint8_t *blob, size_t total, const Deferred *h, int pos, int tw, int th, int dif) {
+    if (vr_gun_len + total + 16 > vr_gun_cap) { vr_gun_cap = (vr_gun_len + total + 16) * 2; vr_gun_buf = realloc(vr_gun_buf, vr_gun_cap); }
+    memcpy(vr_gun_buf + vr_gun_len, &total, sizeof total); memcpy(vr_gun_buf + vr_gun_len + sizeof total, blob, total);
+    vr_gun_len += (sizeof total + total + 7) & ~(size_t)7;
+    if (vr_gun_draws < VR_GUN_MAXD) { vr_gun_dtw[vr_gun_draws] = tw; vr_gun_dth[vr_gun_draws] = th; vr_gun_dtris[vr_gun_draws] = h->nidx / 3; }
