+static void vr_ws_note(Device *d, uint32_t vbase, uint32_t stride, uint32_t min_index, uint32_t nv, uint32_t prims, int how) {
+    Layout L; if (!current_layout(d, &L) || !L.rhw) return;
+    vr_ws.n++; if (how == 2) vr_ws.spilled++; if (how == 1) vr_ws.dropped++;
