+static void vr_gun_move(uint8_t *raw, uint32_t span, uint32_t stride, int pos, PlatDrawState *ps) {
+    double r0 = 1e30, r1 = -1e30, z0 = 0, z1 = 0;               /* the draw's own depth = a + b * rhw, from its extremes */
+    for (uint32_t i = 0; i < span; i++) { float *v = (float *)(raw + (size_t)i * stride + pos); if (!(v[3] > 0)) continue;
+        if (v[3] < r0) { r0 = v[3]; z0 = v[2]; } if (v[3] > r1) { r1 = v[3]; z1 = v[2]; } }
+    if (r1 < r0) return;
+    double b = r1 - r0 > 1e-6 ? (z1 - z0) / (r1 - r0) : 0, a = z0 - b * r0;
+    const float *m = vr_gun_m; float f = vr_gun_f, cx = vr_gun_cx, cy = vr_gun_cy;
+    for (uint32_t i = 0; i < span; i++) {
+        float *v = (float *)(raw + (size_t)i * stride + pos); if (!(v[3] > 0)) continue;
+        float Z = 1.0f / v[3], X = (v[0] - cx) / f * Z, Y = (v[1] - cy) / f * Z;
+        if (X < vr_gun_bmin[0]) vr_gun_bmin[0] = X; if (Y < vr_gun_bmin[1]) vr_gun_bmin[1] = Y; if (Z < vr_gun_bmin[2]) vr_gun_bmin[2] = Z;
+        if (X > vr_gun_bmax[0]) vr_gun_bmax[0] = X; if (Y > vr_gun_bmax[1]) vr_gun_bmax[1] = Y; if (Z > vr_gun_bmax[2]) vr_gun_bmax[2] = Z;
+        vr_gun_nv++;
+        float x = m[0] * X + m[1] * Y + m[2] * Z + m[3], y = m[4] * X + m[5] * Y + m[6] * Z + m[7], z = m[8] * X + m[9] * Y + m[10] * Z + m[11];
+        if (z < 0.05f) z = 0.05f;
+        float rhw = 1.0f / z, d = b != 0 ? (float)(a + b * rhw) : v[2];
+        v[0] = cx + f * x / z; v[1] = cy + f * y / z; v[2] = d < 0 ? 0 : d > 1 ? 1 : d; v[3] = rhw;
+    }
+    if (vr_gun_mirror) ps->cull = ps->cull == PLAT_CULL_CW ? PLAT_CULL_CCW : ps->cull == PLAT_CULL_CCW ? PLAT_CULL_CW : ps->cull;
+}
