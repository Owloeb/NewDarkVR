+/* ---- NewDarkVR (port/core/vr_stereo.c): controller input as if it came from the mouse ---- */
+int vr_input_captured(void) { return captured; }                 /* mouse look (pointer captured) vs a cursor on screen */
+int vr_input_mouse_motion(int dx, int dy) {                      /* relative motion, only while captured: turns the view */
+    if (!captured) return 0;
+    PlatEvent e; memset(&e, 0, sizeof e); e.type = PLAT_EV_MOUSE_MOVE; e.dx = dx; e.dy = dy; on_event(&e, NULL); return 1;
+}
+int vr_input_mouse_abs(int x, int y) {                           /* the cursor to a point of the drawing surface, only while not captured */
+    if (captured) return 0;
+    PlatEvent e; memset(&e, 0, sizeof e); e.type = PLAT_EV_MOUSE_MOVE; e.x = x; e.y = y; on_event(&e, NULL); return 1;
+}
+void vr_input_key(int dik, int down) {                          /* a DirectInput key code (0x0F Tab) */
+    PlatEvent e; memset(&e, 0, sizeof e); e.type = PLAT_EV_KEY; e.key = dik; e.down = down; on_event(&e, NULL);
+}
+void vr_input_mouse_button(int button, int down) {               /* 0 left, 1 right, 2 middle (as PLAT_EV_MOUSE_BUTTON) */
+    PlatEvent e; memset(&e, 0, sizeof e); e.type = PLAT_EV_MOUSE_BUTTON; e.button = button; e.down = down; on_event(&e, NULL);
+}
