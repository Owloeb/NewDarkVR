+/* NewDarkVR (port/core/vr_stereo.c): the held weapon. Inside an eye render the engine clears the depth buffer only
+ * (flags = D3DCLEAR_ZBUFFER) and then draws the first-person weapon with screen-space vertices. While vr_gun_on, those
+ * vertices are turned back into camera space (x right, y down, z forward, in engine units: z = 1 / rhw), moved by
+ * the 3x4 matrix vr_gun_m (to the controller), and projected again. vr_gun_stats collects their camera-space
+ * bounding box before the move, which is how the weapon's own rest position is measured. */
+int vr_gun_on, vr_gun_mirror; float vr_gun_m[12], vr_gun_f, vr_gun_cx, vr_gun_cy;
+float vr_gun_bmin[3], vr_gun_bmax[3]; int vr_gun_nv;
