+        if (v[0] < vr_ws.x0) vr_ws.x0 = v[0]; if (v[0] > vr_ws.x1) vr_ws.x1 = v[0];
+        if (v[1] < vr_ws.y0) vr_ws.y0 = v[1]; if (v[1] > vr_ws.y1) vr_ws.y1 = v[1];
+        if (v[3] < vr_ws.w0) vr_ws.w0 = v[3]; if (v[3] > vr_ws.w1) vr_ws.w1 = v[3];
